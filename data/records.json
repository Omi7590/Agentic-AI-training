  },
  {
    "topic": "PIO reply deadline",
    "rule": "The PIO must reply to an RTI application within 30 days of receipt.",
    "section_or_rule_ref": "Section 7(1), RTI Act 2005",
    "jurisdiction": "Central and State",
    "amount_or_time_limit": "30 days",
    "source_url": "https://rti.gov.in/Writereaddata/RTI-Act.pdf"
  },
  {
    "topic": "Life and liberty deadline",
    "rule": "If the information concerns life or liberty of a person, the PIO must reply within 48 hours.",
    "section_or_rule_ref": "Section 7(1), RTI Act 2005",
    "jurisdiction": "Central and State",
    "amount_or_time_limit": "48 hours",
    "source_url": "https://rti.gov.in/Writereaddata/RTI-Act.pdf"
  },
  {
    "topic": "APIO extra time",
    "rule": "If the application is submitted through an APIO, 5 extra days are added to the reply deadline.",
    "section_or_rule_ref": "Section 5(2), RTI Act 2005",
    "jurisdiction": "Central and State",
    "amount_or_time_limit": "+5 days (total 35 days)",
    "source_url": "https://rti.gov.in/Writereaddata/RTI-Act.pdf"
  },
  {
    "topic": "Transfer under Section 6(3)",
    "rule": "If the application is sent to the wrong PIO, it must be transferred within 5 days and the applicant informed.",
    "section_or_rule_ref": "Section 6(3), RTI Act 2005",
    "jurisdiction": "Central and State",
    "amount_or_time_limit": "5 days to transfer",
    "source_url": "https://rti.gov.in/Writereaddata/RTI-Act.pdf"
  },
  {
