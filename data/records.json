    "amount_or_time_limit": "Rs 10",
    "source_url": "https://rti.gov.in/"
  },
  {
    "topic": "BPL fee exemption",
    "rule": "Applicants below poverty line (BPL) are exempt from all RTI fees.",
    "section_or_rule_ref": "Section 7(5), RTI Act 2005",
    "jurisdiction": "Central and State",
    "amount_or_time_limit": "Nil",
