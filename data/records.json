  {
    "topic": "First appeal",
    "rule": "First appeal must be filed within 30 days of the PIO reply (or non-reply) to the first appellate authority.",
    "section_or_rule_ref": "Section 19(1), RTI Act 2005",
    "jurisdiction": "Central and State",
    "amount_or_time_limit": "Within 30 days",
    "source_url": "https://rti.gov.in/Writereaddata/RTI-Act.pdf"
  },
  {
    "topic": "First appeal fee - Maharashtra",
    "rule": "Fee for filing a first appeal in Maharashtra is Rs 20.",
