    "jurisdiction": "Maharashtra",
    "amount_or_time_limit": "Rs 20",
    "source_url": "https://rti.gov.in/"
  },
  {
    "topic": "Second appeal",
    "rule": "Second appeal lies with the Central Information Commission (CIC) or State Information Commission (SIC) within 90 days of first appeal order.",
    "section_or_rule_ref": "Section 19(3), RTI Act 2005",
    "jurisdiction": "Central and State",
    "amount_or_time_limit": "Within 90 days",
    "source_url": "https://rti.gov.in/Writereaddata/RTI-Act.pdf"
  },
  {
    "topic": "Exemptions under Section 8",
    "rule": "Certain information is exempt from disclosure, including national security, cabinet papers, personal privacy and information given in fiduciary capacity.",
    "section_or_rule_ref": "Section 8, RTI Act 2005",
    "jurisdiction": "Central and State",
    "amount_or_time_limit": "Not applicable",
    "source_url": "https://rti.gov.in/Writereaddata/RTI-Act.pdf"
  },
