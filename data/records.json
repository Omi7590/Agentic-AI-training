    "section_or_rule_ref": "RTI (Fee and Cost) Rules 2005, Rule 4",
    "jurisdiction": "Central",
    "amount_or_time_limit": "Rs 2 per page",
    "source_url": "https://rti.gov.in/Writereaddata/RTI-Act.pdf"
  },
